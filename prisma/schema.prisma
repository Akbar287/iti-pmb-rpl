  SettingKegiatan  SettingKegiatan[]
  SettingCommunity SettingCommunity[]
  SettingWhy       SettingWhy[]
  SettingNumber    SettingNumber[]
  SettingTestimony SettingTestimony[]
  SettingBerita    SettingBerita[]

  @@map("setting_main_page")
}

model SettingKegiatan {
  SettingKegiatanId String          @id @default(uuid()) @map("setting_kegiatan_id")
  JenisKegiatanId   String          @map("jenis_kegiatan_id")
  SettingMainPageId String          @map("setting_main_page_id")
  Nama              String          @map("nama")
  Lokasi            String?         @map("lokasi")
  Deskripsi         String?         @map("deskripsi")
  WaktuMulai        DateTime        @map("waktu_mulai")
  WaktuSelesai      DateTime?       @map("waktu_selesai")
  JenisKegiatan     JenisKegiatan   @relation(fields: [JenisKegiatanId], references: [JenisKegiatanId], onDelete: Cascade)
  SettingMainPage   SettingMainPage @relation(fields: [SettingMainPageId], references: [SettingMainPageId], onDelete: Cascade)

  @@map("setting_kegiatan")
}

model SettingCommunity {
  SettingCommunityId String @id @default(uuid()) @map("setting_community_id")
  SettingMainPageId  String @map("setting_main_page_id")
  Title              String @map("title")
  Gambar             Bytes  @map("gambar")

  SettingMainPage SettingMainPage @relation(fields: [SettingMainPageId], references: [SettingMainPageId], onDelete: Cascade)

  @@map("setting_community")
}

model SettingWhy {
  SettingWhyId      String @id @default(uuid()) @map("setting_why_id")
  SettingMainPageId String @map("setting_main_page_id")
  Icon              String @map("icon")
  Title             String @map("title")
  Subtitle          String @map("subtitle")

  SettingMainPage SettingMainPage @relation(fields: [SettingMainPageId], references: [SettingMainPageId], onDelete: Cascade)

  @@map("setting_why")
}

model SettingNumber {
  SettingNumberId   String @id @default(uuid()) @map("setting_number_id")
  SettingMainPageId String @map("setting_main_page_id")
  Title             String @map("title")
  Subtitle          String @map("subtitle")
  Angka             String @map("angka")

  SettingMainPage SettingMainPage @relation(fields: [SettingMainPageId], references: [SettingMainPageId], onDelete: Cascade)

  @@map("setting_number")
}

model SettingTestimony {
  SettingTestimonyId String @id @default(uuid()) @map("setting_testimony_id")
  SettingMainPageId  String @map("setting_main_page_id")
  Nama               String @map("nama")
  Jabatan            String @map("jabatan")
  JurusanTahun       String @map("jurusan_tahun")
  Testimoni          String @map("testimoni")
  Foto               Bytes  @map("foto")

  SettingMainPage SettingMainPage @relation(fields: [SettingMainPageId], references: [SettingMainPageId], onDelete: Cascade)

  @@map("setting_testimony")
}

model SettingBerita {
  SettingBeritaId   String   @id @default(uuid()) @map("setting_berita_id")
  KategoriBeritaId  String   @map("kategori_berita_id")
  SettingMainPageId String   @map("setting_main_page_id")
  Title             String   @map("title")
  Deskripsi         String   @map("deskripsi")
  Gambar            Bytes?   @map("gambar")
  Populer           Boolean  @default(false) @map("populer")
  Waktu             DateTime @map("waktu")

  SettingMainPage SettingMainPage @relation(fields: [SettingMainPageId], references: [SettingMainPageId], onDelete: Cascade)
  KategoriBerita  KategoriBerita  @relation(fields: [KategoriBeritaId], references: [KategoriBeritaId], onDelete: Cascade)

  @@map("setting_berita")
}

model QuestionAndAsk {
  QuestionAndAskId String   @id @default(uuid()) @map("question_and_ask_id")
  Question         String   @map("question")
  Answer           String   @map("answer")
  CreatedAt        DateTime @default(now()) @map("created_at")
  UpdatedAt        DateTime @default(now()) @map("updated_at")

  @@map("question_and_ask")
}

model Tickets {
  TicketsId    String             @id @default(uuid()) @map("tickets_id")
  UserId       String             @map("user_id")
  RoleId       String             @map("role_id")
  KepadaRoleId String             @map("kepada_role_id")
  Subject      String             @map("subject")
  Message      String             @map("message")
  Status       StatusTiketBantuan @map("status")
  CreatedAt    DateTime           @default(now()) @map("created_at")
  UpdatedAt    DateTime           @default(now()) @map("updated_at")

  User         User          @relation(fields: [UserId], references: [UserId], onDelete: Cascade)
  Role         Role          @relation("RoleTickets", fields: [RoleId], references: [RoleId], onDelete: Cascade)
  KepadaRole   Role          @relation("KepadaRoleTickets", fields: [KepadaRoleId], references: [RoleId], onDelete: Cascade)
  ticketsFiles TicketsFile[]

  @@map("tickets")
}

model TicketsFile {
  TicketsFileId String   @id @default(uuid()) @map("tickets_file_id")
  TicketsId     String   @map("tickets_id")
  NamaFile      String   @map("nama_file")
  FileData      Bytes    @map("file_data")
  NamaDokumen   String   @map("nama_dokumen")
  CreatedAt     DateTime @default(now()) @map("created_at")
  UpdatedAt     DateTime @default(now()) @map("updated_at")

  Tickets Tickets @relation(fields: [TicketsId], references: [TicketsId], onDelete: Cascade)

  @@map("tickets_file")
}

model TranskripNilai {
  TranskripNilaiId String   @id @default(uuid()) @map("transkrip_nilai_id")
  PendaftaranId    String   @map("pendaftaran_id")
  KodeMataKuliah   String   @map("kode_mata_kuliah")
  NamaMataKuliah   String   @map("nama_mata_kuliah")
  Sks              Float    @map("sks")
  Nilai            String   @map("nilai")
  CreatedAt        DateTime @default(now()) @map("created_at")
  UpdatedAt        DateTime @default(now()) @map("updated_at")

  Pendaftaran             Pendaftaran              @relation(fields: [PendaftaranId], references: [PendaftaranId], onDelete: Cascade)
  transkripNilaiRelations TranskripNilaiRelation[]

  @@map("transkrip_nilai")
}

model TranskripNilaiRelation {
  TranskripNilaiId String         @map("transkrip_nilai_id")
  TranskripNilai   TranskripNilai @relation(fields: [TranskripNilaiId], references: [TranskripNilaiId], onDelete: Cascade)

  MataKuliahMahasiswaId String              @map("mata_kuliah_mahasiswa_id")
  MataKuliahMahasiswa   MataKuliahMahasiswa @relation(fields: [MataKuliahMahasiswaId], references: [MataKuliahMahasiswaId], onDelete: Cascade)

  Nilai  String  @map("nilai")
  Diakui Boolean @default(false) @map("diakui")

  @@id([TranskripNilaiId, MataKuliahMahasiswaId])
  @@map("transkrip_nilai_relation")
}
